PORT=3000
BACKEND_EXTERNAL_PORT=3001
NODE_ENV=production
CORS_ORIGINS=https://your-domain.uz,http://localhost:5173

# Database (PostgreSQL)
DB_HOST=postgres
DB_PORT=5432
DB_EXTERNAL_PORT=5436
DB_USERNAME=postgres
DB_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
DB_NAME=uvd_app_db
DB_SYNCHRONIZE=false

# Redis Cache
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_EXTERNAL_PORT=6383
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD

# MinIO (S3 Object Storage)
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_EXTERNAL_PORT=9200
MINIO_CONSOLE_EXTERNAL_PORT=9201
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=CHANGE_ME_STRONG_MINIO_PASSWORD
MINIO_BUCKET_NAME=uvd-attachments

# JWT Configuration (openssl rand -hex 32)
JWT_ACCESS_SECRET=CHANGE_ME_64_CHAR_RANDOM_ACCESS_SECRET
JWT_REFRESH_SECRET=CHANGE_ME_64_CHAR_RANDOM_REFRESH_SECRET
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ONLYOFFICE JWT Configuration (openssl rand -hex 32)
ONLYOFFICE_JWT_SECRET=CHANGE_ME_64_CHAR_RANDOM_ONLYOFFICE_SECRET
ONLYOFFICE_INTERNAL_URL=http://uvd_app_onlyoffice

# Super Admin boshlang'ich ma'lumotlari (birinchi marta run bo'lganda avtomatik yaratiladi)
SUPER_ADMIN_USERNAME=admin
SUPER_ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD
SUPER_ADMIN_FIRST_NAME=Admin
SUPER_ADMIN_LAST_NAME=Boshqaruvchi
SUPER_ADMIN_PHONE=+998901234567
